# Phoenix Configuration

# LLM Backend: "ollama" or "openrouter"
PHOENIX_LLM_BACKEND=ollama

# Ollama Settings
PHOENIX_OLLAMA_BASE_URL=http://localhost:11434
PHOENIX_OLLAMA_MODEL=deepseek-coder-v2

# OpenRouter Settings
OPENROUTER_API_KEY=
PHOENIX_OPENROUTER_MODEL=deepseek/deepseek-coder

# Docker Validation
PHOENIX_DOCKER_IMAGE=php:8.3-cli
PHOENIX_DOCKER_TIMEOUT=30
PHOENIX_TEST_COMMAND=vendor/bin/phpunit

# Patcher
PHOENIX_AUTO_APPLY=true
PHOENIX_MIN_CONFIDENCE=0.8

# Storage
PHOENIX_DB_PATH=data/phoenix.db
PHOENIX_BACKUP_DIR=backups
